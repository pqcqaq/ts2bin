+	diagnostics := RunSubsetGate(snapshot)
+	if len(diagnostics) != 1 || diagnostics[0].EntityID != "node/project" || diagnostics[0].MessageKey != "subset.any_type" {
+		t.Fatalf("diagnostics = %#v", diagnostics)
+	}
+}
