+			const scope = { value: 1 };
+			// @ts-ignore: the diagnostic is intentionally suppressed.
+			with (scope) {}
+		`,
+	})
+	build, err := buildProgram(context.Background(), request)
+	if err != nil {
+		t.Fatal(err)
+	}
