+
+	got := RunSubsetGate(ProgramSnapshot{SchemaVersion: SnapshotSchemaVersion, Config: ConfigSnapshot{Bingo: BingoOptions{Profile: ProfileStatic}}, Nodes: []NodeSnapshot{}, Types: []TypeSnapshot{}})
+	if got == nil || len(got) != 0 {
