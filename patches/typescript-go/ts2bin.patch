+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), `"emit": []`) {
+		t.Fatalf("empty emit request was omitted from build plan wire:\n%s", data)
+	}
+	decoded, err := DecodeBuildPlan(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(decoded.Backend.Emit) != 0 {
