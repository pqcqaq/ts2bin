+			t.Fatalf("plan provenance = %#v", plan)
+		}
+		if index == 0 {
+			firstPlan = plan
+		} else if plan.ContentHash == firstPlan.ContentHash {
+			t.Fatalf("backend variant did not invalidate build plan: %#v", plan)
+		}
+	}
