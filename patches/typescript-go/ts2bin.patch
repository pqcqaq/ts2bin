+	if got.ResolvePackageJSONExports || !got.ResolvePackageJSONImports || !got.ResolveJSONModule ||
+		!got.NoDTSResolution || !got.NoUncheckedSideEffectImports || !got.NoPropertyAccessFromIndexSig {
